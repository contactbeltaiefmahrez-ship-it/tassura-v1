Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:config|includes|pages|private|database|docs)(?:/|$) - [F,L,NC]
RewriteRule ^(?:README|INSTALLATION|VERIFICATION)\.md$ - [F,L,NC]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "\.(sql|md)$">
Require all denied
</FilesMatch>
